# CampusDesk — Apache Configuration for XAMPP
# File: .htaccess

DirectoryIndex index.php index.html

# Prevent directory browsing
Options -Indexes +FollowSymLinks

# Set default charset
AddDefaultCharset UTF-8

# Error handling
ErrorDocument 404 /campusdesk/index.php
ErrorDocument 403 /campusdesk/index.php

# PHP settings safety (if mod_php is used)
<IfModule mod_php8.c>
    php_flag display_errors On
    php_value error_reporting E_ALL
</IfModule>
